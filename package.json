{
	"name": "rolldown-plugin-userscript",
	"version": "1.1.3",
	"description": "Rolldown plugin for UserScripts",
	"author": "Seized and Desisted",
	"license": "MIT",
	"scripts": {
		"ci": "bun run lint && bun run test",
		"lint": "oxlint src/ test/",
		"lint:fix": "oxlint src/ test/ --fix",
		"fmt": "oxfmt src/ test/",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist",
		"build": "tsdown",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"type": "module",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"readme": "ReadME.md",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"ReadME.md",
		"LICENSE"
	],
	"keywords": [
		"rolldown",
		"userscript"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dependencies": {
		"@oxc-project/types": "^0.145.0",
		"oxc-parser": "^0.145.0",
		"oxc-walker": "^1.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"globals": "^17.11.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"rolldown": "^1.2.4",
		"tsdown": "0.22.14",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"rolldown": "^1.2.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MinibloxCheaters2/rolldown-plugin-userscript.git"
	},
	"engines": {
		"node": ">=18",
		"bun": ">=1"
	}
}
